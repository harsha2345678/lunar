# ==============================================================================
# LUNAR SENTRY AI - Root Git Ignore Configuration
# ==============================================================================

# Node.js & Frontend Dependencies and Build Outputs
node_modules/
*/node_modules/
dist/
*/dist/
.vite/
*/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python Virtual Environments & Cache
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
*/.venv/
venv/
*/venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/

# Local Environment Variables & Secrets
.env
.env.*
!.env.example
!*.env.example
backend/.env
lunar-sentry-ai/.env
lunar-sentry-ai/.env.local

# Databases & Machine-Specific Generated Files
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Uploaded Files & Temporary Processing Media (preserve folder structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/media/*
!backend/media/.gitkeep

# Large AI Model Weights (YOLO / PyTorch / ONNX)
# Inspect file size and distribute via Git LFS or external artifact store
*.pt
*.pth
*.onnx
*.bin
weights/
backend/weights/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
