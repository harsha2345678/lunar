# Lunar Sentry AI - Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NEVER commit your local .env file to Git.

APP_NAME="Lunar Sentry AI - Mission Control API"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Origins - Comma-separated list or JSON array of allowed frontend URLs
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (SQLite default for local development)
DATABASE_URL="sqlite:///./lunar_sentry.db"

# Storage Directories
UPLOAD_DIR="./uploads"
MEDIA_DIR="./media"

# File Upload Limits (in megabytes)
MAX_UPLOAD_SIZE_MB=50

# Optional Model Configuration
MODEL_WEIGHTS_PATH="./weights/yolov9_lunar.pt"
MODEL_CONFIDENCE_THRESHOLD=0.50
